node_modules/
dist/
build/
.wrangler/
.astro/
.expo/

# Secrets — never commit
.dev.vars*
!.dev.vars.example
.env*
!.env.example
*.pem
*.key

# A church's own brand directory is its own — never committed here. The
# directory itself is tracked (see brands/README.md) so a fresh clone has
# somewhere to put one; everything inside it is ignored.
tenants/
brands/*/

# OS / editor
.DS_Store
Thumbs.db
*.tsbuildinfo
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
coverage/

# Per-deployment Wrangler config — copy from the .example files
apps/*/wrangler.jsonc
apps/*/wrangler.toml

# Admin build-time config
apps/admin/.env

# Expo / React Native
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/

# Local Docker stack — generated per machine, carries test credentials
docker/.env
apps/api/wrangler.local.jsonc
.wrangler/

# Logos and images written by `churchkit brand` from a church's own brand
# directory. Generated, and a church's own — never committed here. The one
# exception: HomeScreen.tsx requires apps/mobile/assets/icon.png directly
# (not through brand.json's assetDir), and EAS Build's upload step filters
# by .gitignore — an icon that exists only on a developer's machine never
# reaches the remote build, so its first bundle fails on that require. A
# bare `apps/mobile/assets/` ignore blocks git from ever looking inside the
# directory to honor that exception, so it needs the trailing `/*` below.
apps/web/public/images/
apps/mobile/assets/*
!apps/mobile/assets/icon.png
