node_modules/
dist/
build/
.wrangler/
.astro/
.expo/

# Secrets — never commit
.dev.vars*
!.dev.vars.example
.env*
!.env.example
*.pem
*.key

# A church's own brand directory is its own — never committed here. The
# directory itself is tracked (see brands/README.md) so a fresh clone has
# somewhere to put one; everything inside it is ignored.
tenants/
brands/*/

# OS / editor
.DS_Store
Thumbs.db
*.tsbuildinfo
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
coverage/

# Per-deployment Wrangler config — copy from the .example files
apps/*/wrangler.jsonc
apps/*/wrangler.toml

# Admin build-time config
apps/admin/.env

# Expo / React Native
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/

# Local Docker stack — generated per machine, carries test credentials
docker/.env
apps/api/wrangler.local.jsonc
.wrangler/
