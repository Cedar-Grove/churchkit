{
  "name": "churchkit",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source website, mobile app, and admin platform for churches, built on Planning Center.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cedar-grove/churchkit.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "churchkit": "node tools/src/cli.mjs"
  }
}