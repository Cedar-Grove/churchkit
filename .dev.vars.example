# ChurchKit API — local development secrets.
#
# On Cloudflare these become Worker secrets; self-hosted they are ordinary
# environment variables. Same names either way.
# Copy to apps/api/.dev.vars and fill in. NEVER commit the filled copy.
# Every value below is per-church: each deployment registers its own.
# See docs/deploy-cloudflare.md (or deploy-self-hosted.md) for where to
# obtain each one.

# ── Planning Center ─────────────────────────────────────────────
# OAuth app (user login). PKCE flow — no client secret exists.
PCO_CLIENT_ID=
# Personal Access Token (server-side API calls)
PCO_API_ID=
PCO_API_SECRET=
# Services > your Sunday service type > numeric ID in the URL
PCO_SERVICE_TYPE_ID=
# People > Settings > Note Categories (create these first)
PCO_CONNECT_CARD_NOTE_CATEGORY_ID=
PCO_PRAYER_REQUEST_NOTE_CATEGORY_ID=
PCO_IM_NEW_NOTE_CATEGORY_ID=
# PCO Forms with an "add to workflow" automation attached. Optional: with
# no ID set, that form files no workflow card and everything else still
# works. (PCO refuses direct WorkflowCard creation over API credentials,
# so submitting to a form is the only way to file one.)
PCO_CONNECT_CARD_FORM_ID=
PCO_PRAYER_REQUEST_FORM_ID=
PCO_IM_NEW_FORM_ID=

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
# A form with no address set is still recorded and still filed to Planning
# Center; only the staff notification is skipped.
EMAIL_STAFF_CONNECT_CARD=
EMAIL_STAFF_IM_NEW=
EMAIL_STAFF_CONTACT=
EMAIL_FROM_PASTOR=

# ── Push (OneSignal) ────────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── Sermon video (YouTube Data API v3) ──────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ── Admin auth ──────────────────────────────────────────────────
# How admin requests are authenticated. There is no default: an unset or
# unrecognised mode leaves the admin API refusing everything.
#   cloudflare-access  a signed JWT injected at Cloudflare's edge
#   proxy-header       an identity header set by a reverse proxy you run
ADMIN_AUTH_MODE=cloudflare-access

# For cloudflare-access. Zero Trust > Access > your admin app >
# Application Audience (AUD) tag.
CF_ACCESS_AUD=

# For proxy-header. Only as strong as your proxy's exclusivity: if the API
# is reachable around it, anyone can send the header and become an admin.
# See docs/deploy-self-hosted.md.
ADMIN_PROXY_HEADER=x-forwarded-email
ADMIN_PROXY_SHARED_SECRET=

# ── Bot protection (Cloudflare Turnstile) ───────────────────────
# Optional. With no secret set, form endpoints keep their other guards.
TURNSTILE_SECRET=

# ── Scripture ───────────────────────────────────────────────────
# Bible Brain / Faith Comes By Hearing — audio + text
BIBLE_BRAIN_API_KEY=
# API.Bible (scripture.api.bible) — additional translations
BIBLE_API_KEY=

# ── Self-hosted only ────────────────────────────────────────────
# Ignored on Cloudflare, where D1 and R2 arrive as bindings instead.
# CHURCHKIT_DB=./data/churchkit.db
# CHURCHKIT_MEDIA_DIR=./data/media
# HOST=127.0.0.1
# PORT=8787
