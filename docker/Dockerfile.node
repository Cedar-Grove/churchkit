# One image for all three apps.
#
# They share a toolchain (Node, npm workspaces, wrangler) and differ only in
# the command they run, so a single image keeps the local stack to one build
# instead of three near-identical ones.
#
# This is a development image. It mounts the working tree and runs each app's
# dev server so edits are picked up live; it is not how ChurchKit is
# deployed, and it is not hardened for anything but a laptop.
FROM node:22-bookworm-slim

# workerd (which wrangler runs Workers in locally) needs these.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /repo

# Dependencies are installed into the mounted tree at first run rather than
# baked in: the workspace layout means a single npm install covers every app,
# and baking it would go stale the moment a dependency changed.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    CI=true

EXPOSE 8787 4321 4322

CMD ["node", "--version"]
