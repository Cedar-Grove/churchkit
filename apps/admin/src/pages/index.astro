---
// Cloudflare Access protects this entire site at the edge. By the time a
// request reaches here the user is already authenticated against whatever
// identity provider this church configured in its Access application.
import AdminApp from "../components/AdminApp";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Roboto:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <style>
      /*
        The admin panel deliberately uses its own typography rather than the
        church's brand fonts: it is a staff tool, not a public page, and
        ChurchKit bundles no commercially licensed font files.
      */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; }
      body { background: #faf8f3; font-family: "DM Sans", sans-serif; }
      #admin-root { min-height: 100vh; }
    </style>
  </head>
  <body>
    <div id="admin-root">
      <!-- client:only so there is no SSR mismatch -->
      <AdminApp client:only="react" />
    </div>
  </body>
</html>
