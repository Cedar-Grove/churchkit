# Build-time configuration for the admin panel.
#
# Leave unset (or empty) in production: apps/admin/src/worker.mjs proxies
# /api/* to the API worker over a service binding, so the built SPA calls
# same-origin relative paths — `churchkit provision` writes it this way.
#
# Set it only to point a local `astro dev` server at a different API, e.g.
# a local API dev server on another port.
PUBLIC_API_BASE=
