    "start:node": "node dist/server.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.87.0",
    "esbuild": "^0.28.0",
    "@types/node": "^22.10.0"
  }
}