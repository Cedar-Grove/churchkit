{
  "name": "@churchkit/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ChurchKit API \u2014 Cloudflare Worker.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
