---
import Layout from '../layouts/Layout.astro';
import HoneypotField from '../components/HoneypotField.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getStaff, getSettings } from '../lib/api';
import { env } from '../lib/env';

let staff: any[] = [];
try {
  staff = await getStaff(env.API_BASE);
} catch {}

const settings = await getSettings(env.API_BASE).catch(() => ({} as any));
---

<Layout title="Contact" description="Get in touch with us.">
  <Nav />

  <section class="page-header">
    <div class="container">
      <p class="page-header__eyebrow">Reach Out</p>
      <h1 class="page-header__title">Contact Us</h1>
      <p class="page-header__body">We'd love to hear from you. Send us a message or stop by on Sunday.</p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-info">
          <div class="contact-block">
            <h3 class="contact-block__title">Location</h3>
            <p class="contact-block__body">{settings.address ?? ''}</p>
            {settings.address && (
              <a href={`https://maps.google.com/?q=${encodeURIComponent(settings.address)}`} target="_blank" rel="noopener" class="btn btn--outline" style="margin-top: 14px;">Get Directions →</a>
            )}
          </div>
          <div class="contact-block">
            <h3 class="contact-block__title">Phone &amp; Email</h3>
            <p class="contact-block__body">
              {settings.phone && <a href={`tel:${settings.phone.replace(/[^0-9+]/g, '')}`}>{settings.phone}</a>}<br />
              {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
            </p>
          </div>
          <div class="contact-block">
            <h3 class="contact-block__title">Service Times</h3>
            <p class="contact-block__body">
              <strong>Sundays</strong><br />
              9:00 AM — Sunday School<br />
              10:00 AM — Worship Service<br /><br />
              <strong>Wednesdays</strong><br />
              11:00 AM — Adult Bible Study<br />
              6:30 PM — Adults, Kids &amp; Youth
            </p>
          </div>
          <div class="contact-block">
            <h3 class="contact-block__title">New here?</h3>
            <p class="contact-block__body" style="margin-bottom: 12px;">Fill out a connect card and our team will reach out.</p>
            <a href="/connect-card" class="btn btn--primary">Fill Out a Connect Card</a>
          </div>
          <div class="contact-block">
            <h3 class="contact-block__title">Need Prayer?</h3>
            <p class="contact-block__body" style="margin-bottom: 12px;">Share a prayer request and our team will lift it up.</p>
            <a href="/prayer-request" class="btn btn--outline">Share a Prayer Request</a>
          </div>
        </div>

        <div class="contact-form-col">
          <h2 class="contact-form-title">Send a Message</h2>
          <form id="contact-form" class="form" data-api-base={env.API_BASE}>
        <HoneypotField />
        <TurnstileWidget />
            <div class="form__row">
              <div class="form__field">
                <label class="form__label" for="name">Your Name *</label>
                <input class="form__input" type="text" id="name" name="name" required />
              </div>
              <div class="form__field">
                <label class="form__label" for="email">Email Address *</label>
                <input class="form__input" type="email" id="email" name="email" required />
              </div>
            </div>
            <div class="form__field">
              <label class="form__label" for="phone">Phone Number</label>
              <input class="form__input" type="tel" id="phone" name="phone" />
            </div>
            <div class="form__field">
              <label class="form__label" for="subject">Subject</label>
              <select class="form__input form__select" id="subject" name="subject">
                <option value="">— Select a topic —</option>
                <option value="general">General Question</option>
                <option value="prayer">Prayer Request</option>
                <option value="membership">Membership</option>
                <option value="wedding">Wedding / Special Event</option>
                <option value="counseling">Pastoral Counseling</option>
                <option value="missions">Missions / Outreach</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form__field">
              <label class="form__label" for="message">Message *</label>
              <textarea class="form__input form__textarea" id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn--primary form__submit">Send Message →</button>
          </form>
          <div id="form-success" class="form-message form-message--success" style="display:none">
            <strong>Message sent!</strong> Thank you for reaching out. We'll get back to you soon.
          </div>
          <div id="form-error" class="form-message form-message--error" style="display:none">
            Something went wrong. Please try again, or contact us if it keeps happening.
          </div>
        </div>
      </div>
    </div>
  </section>

  {staff.length > 0 && (
    <section class="section staff-section">
      <div class="container">
        <p class="section__eyebrow">Our Team</p>
        <h2 class="section__heading">Staff Directory</h2>
        <div class="staff-grid">
          {staff.map((member: any) => (
            <div class="staff-card">
              {member.photo_url ? (
                <img src={member.photo_url} alt={member.name} class="staff-card__photo" loading="lazy" />
              ) : (
                <div class="staff-card__avatar">
                  {member.name.split(' ').map((n: string) => n[0]).slice(0, 2).join('')}
                </div>
              )}
              <div class="staff-card__info">
                <h3 class="staff-card__name">{member.name}</h3>
                <p class="staff-card__title">{member.title}</p>
                {member.email && (
                  <a href={`mailto:${member.email}`} class="staff-card__email">{member.email}</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</Layout>

<style>
  .page-header { background: var(--brand); padding: 130px 0 108px; }
  .page-header__eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent); margin-bottom: 12px; }
  .page-header__title { font-size: clamp(50px, 7vw, 73px); font-weight: 600; color: white; line-height: 1.1; margin-bottom: 12px; }
  .page-header__body { font-family: var(--font-heading); font-size: 24px; color: rgba(255,255,255,0.7); font-weight: 300; }

  .contact-section { background: white; }
  .contact-layout { display: grid; grid-template-columns: 320px 1fr; gap: 64px; align-items: start; }

  .contact-block { margin-bottom: 32px; }
  .contact-block__title { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--brand); margin-bottom: 10px; }
  .contact-block__body { font-family: var(--font-heading); font-size: 21px; color: var(--ink-soft); line-height: 1.8; font-weight: 300; }
  .contact-block__body a { color: var(--brand); text-decoration: none; }
  .contact-block__body a:hover { text-decoration: underline; }

  .contact-form-title { font-size: 39px; color: var(--brand); font-weight: 600; margin-bottom: 28px; }
  .form { display: flex; flex-direction: column; gap: 20px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form__field { display: flex; flex-direction: column; gap: 6px; }
  .form__label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
  .form__input { padding: 11px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: 15px; font-family: var(--font-body); color: var(--ink); background: white; outline: none; transition: border-color 0.15s; }
  .form__input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(45,74,43,0.08); }
  .form__select { appearance: none; cursor: pointer; }
  .form__textarea { resize: vertical; min-height: 120px; }
  .form__submit { align-self: flex-start; padding: 14px 32px; font-size: 15px; }

  .form-message { padding: 20px 24px; border-radius: 10px; margin-top: 4px; font-size: 21px; line-height: 1.5; }
  .form-message--success { background: #edf7ed; color: #1a4a1a; border: 1px solid #b8d8b8; }
  .form-message--error { background: #fef2f2; color: #7a1a1a; border: 1px solid #f0b8b8; }

  .staff-section { background: var(--brand-faint); }
  .staff-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 36px; }
  .staff-card { display: flex; gap: 16px; align-items: center; background: white; border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
  .staff-card__photo { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .staff-card__avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--brand-pale); display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 20px; font-weight: 700; color: var(--brand); flex-shrink: 0; }
  .staff-card__name { font-size: 22px; color: var(--brand); font-weight: 600; margin-bottom: 2px; }
  .staff-card__title { font-size: 11px; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500; margin-bottom: 6px; }
  .staff-card__email { font-size: 12px; color: var(--brand-mid); text-decoration: none; word-break: break-all; }
  .staff-card__email:hover { text-decoration: underline; }

  @media (max-width: 1000px) {
    .contact-layout { grid-template-columns: 1fr; }
    .staff-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .form__row { grid-template-columns: 1fr; }
    .staff-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { awaitTurnstileToken } from '../lib/turnstile';
  import { showFormError } from '../lib/forms';

  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Sending...';
    btn.disabled = true;
    // Turnstile injects its hidden input into the form, so FormData picks
    // the token up on its own — but only once it's there.
    const token = await awaitTurnstileToken(form);
    if (!token && form.querySelector('.cf-turnstile')) {
      showFormError(form, btn, 'Still checking your browser — please wait a moment and submit again.', 'Send Message →');
      return;
    }

    const data = Object.fromEntries(new FormData(form));
    try {
      const res = await fetch(`${form.dataset.apiBase}/api/forms/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.style.display = 'none';
        document.getElementById('form-success')!.style.display = 'block';
        return;
      }
      throw new Error(res.status === 403 ? 'verification' : 'server');
    } catch (e) {
      showFormError(
        form,
        btn,
        (e as Error).message === 'verification' ? 'We could not verify that you are human. Please reload the page and try again.' : '',
        'Send Message →',
      );
    }
  });
</script>

