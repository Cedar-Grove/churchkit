---
import Layout from '../layouts/Layout.astro';
import HoneypotField from '../components/HoneypotField.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getSettings, getPage } from '../lib/api';
import { env } from '../lib/env';

let settings: any = {};
try {
  settings = await getSettings(env.API_BASE);
} catch {}

// No invented times, and no assumption about which days. A wrong service
// time sends a visitor to a locked building, in the church's own voice.
const serviceTimes: Record<string, string[]> = settings.service_times ?? {};
const serviceNotes: Record<string, string> = settings.service_notes ?? {};
const serviceDays: [string, string[], string | undefined][] = Object.entries(serviceTimes)
  .filter(([, times]) => Array.isArray(times) && times.length > 0)
  .map(([day, times]) => [day.charAt(0).toUpperCase() + day.slice(1), times as string[], serviceNotes[day]]);

// "What to expect" is this church's own writing, not ours. Anything the
// previous version asserted here — dress code, parking, service length,
// who preaches, how communion is taken — differs from church to church.
let page: any = null;
try {
  page = await getPage('im-new', env.API_BASE);
} catch {}
---

<Layout title="I'm New" description="Planning your first visit? Here's what to expect.">
  <Nav />

  <section class="page-header">
    <div class="container">
      <p class="page-header__eyebrow">Welcome</p>
      <h1 class="page-header__title">I'm New Here</h1>
      <p class="page-header__body">We'd love to meet you. Here's what to expect when you visit for the first time.</p>
    </div>
  </section>

  <!-- Service Times -->
  <section class="section times-section">
    <div class="container--narrow">
      <p class="section__eyebrow">When We Gather</p>
      <h2 class="section__heading" hidden={serviceDays.length === 0}>Service Times</h2>
      <div class="times-grid">
        {serviceDays.map(([day, times, note]) => (
          <div class="time-block">
            <h3 class="time-block__day">{day}</h3>
            {times.map((t) => <div class="time-block__time">{t}</div>)}
            {note && <p class="time-block__note">{note}</p>}
          </div>
        ))}
      </div>
      <div class="location-card">
        <div class="location-card__info">
          <h3 class="location-card__title">Find Us</h3>
          {settings.address && <p>{settings.address}</p>}
          {settings.phone && <p style="margin-top: 8px;">{settings.phone}</p>}
        </div>
        {settings.address && (
          <a href={`https://maps.google.com/?q=${encodeURIComponent(settings.address)}`} target="_blank" rel="noopener" class="btn btn--accent">Get Directions →</a>
        )}
      </div>
    </div>
  </section>

  {/*
    What to expect is content, not layout: it belongs to the church, and is
    edited on its `im-new` page in the admin panel. With nothing published,
    this section is absent rather than filled with someone else's claims.
  */}
  {page?.content_html && (
    <section class="section expect-section">
      <div class="container--narrow">
        <p class="section__eyebrow">Your First Visit</p>
        <h2 class="section__heading">What to Expect</h2>
        <div class="expect-list" set:html={page.content_html} />
      </div>
    </section>
  )}

  <!-- Visitor Form -->
  <section class="section form-section">
    <div class="container--narrow">
      <p class="section__eyebrow">Stay in Touch</p>
      <h2 class="section__heading">Let Us Know You're Coming</h2>
      <p class="section__body" style="margin-bottom: 36px;">Fill out the form below and our team will reach out to welcome you.</p>

      <form id="visitor-form" class="form" data-api-base={env.API_BASE}>
        <HoneypotField />
        <TurnstileWidget />
        <div class="form__row">
          <div class="form__field">
            <label class="form__label" for="firstName">First Name *</label>
            <input class="form__input" type="text" id="firstName" name="firstName" required />
          </div>
          <div class="form__field">
            <label class="form__label" for="lastName">Last Name *</label>
            <input class="form__input" type="text" id="lastName" name="lastName" required />
          </div>
        </div>
        <div class="form__row">
          <div class="form__field">
            <label class="form__label" for="email">Email Address *</label>
            <input class="form__input" type="email" id="email" name="email" required />
          </div>
          <div class="form__field">
            <label class="form__label" for="phone">Phone Number</label>
            <input class="form__input" type="tel" id="phone" name="phone" />
          </div>
        </div>
        <div class="form__field">
          <label class="form__label" for="visitDate">When are you planning to visit?</label>
          <input class="form__input" type="date" id="visitDate" name="visitDate" />
        </div>
        <div class="form__field">
          <label class="form__label" for="howHeard">How did you hear about us?</label>
          <select class="form__input form__select" id="howHeard" name="howHeard">
            <option value="">— Select —</option>
            <option value="friend">Friend or Family</option>
            <option value="search">Google / Search</option>
            <option value="social">Social Media</option>
            <option value="drove-by">Drove By</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form__field">
          <label class="form__label" for="notes">Questions or Anything Else?</label>
          <textarea class="form__input form__textarea" id="notes" name="notes" rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn--primary form__submit">Send →</button>
      </form>

      <div id="form-success" class="form-message form-message--success" style="display:none">
        <strong>Thank you!</strong> We're glad you're coming. One of our team members will be in touch soon.
      </div>
      <div id="form-error" class="form-message form-message--error" style="display:none">
        Something went wrong. Please try again, or contact us if it keeps happening.
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header { background: var(--brand); padding: 130px 0 108px; }
  .page-header__eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent); margin-bottom: 12px; }
  .page-header__title { font-size: clamp(50px, 7vw, 73px); font-weight: 600; color: white; line-height: 1.1; margin-bottom: 12px; }
  .page-header__body { font-family: var(--font-heading); font-size: 24px; color: rgba(255,255,255,0.7); font-weight: 300; }

  .times-section { background: white; }
  .times-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 32px 0 24px; }
  .time-block { background: var(--brand-faint); border-radius: 14px; padding: 28px; }
  .time-block__day { font-family: var(--font-heading); font-size: 31px; color: var(--brand); font-weight: 600; margin-bottom: 16px; }
  .time-block__time { font-size: 22px; color: var(--ink-soft); margin-bottom: 8px; padding-left: 12px; border-left: 3px solid var(--accent); }
  .time-block__note { font-family: var(--font-heading); font-size: 13px; color: var(--ink-faint); margin-top: 14px; line-height: 1.6; font-weight: 300; }

  .location-card { display: flex; align-items: center; justify-content: space-between; gap: 24px; background: var(--brand); color: white; border-radius: 16px; padding: 28px 32px; }
  .location-card__title { font-family: var(--font-heading); font-size: 28px; font-weight: 600; margin-bottom: 8px; }
  .location-card__info { font-size: 21px; line-height: 1.8; }

  .expect-section { background: var(--brand-faint); }
  /* content_html is set:html-injected — Astro's scoping never reaches it,
     so everything below the wrapper itself needs :global(). */
  .expect-list { margin-top: 36px; }
  .expect-list :global(.expect-item) { display: flex; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--border); }
  .expect-list :global(.expect-item:last-child) { border-bottom: none; }
  .expect-list :global(.expect-item__num) { width: 40px; height: 40px; background: var(--brand); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 18px; font-weight: 700; flex-shrink: 0; }
  .expect-list :global(.expect-item__title) { font-size: 28px; color: var(--brand); font-weight: 600; margin-bottom: 8px; }
  .expect-list :global(.expect-item__body) { font-family: var(--font-heading); font-size: 21px; color: var(--ink-soft); line-height: 1.7; font-weight: 300; }

  .form-section { background: white; }
  .form { display: flex; flex-direction: column; gap: 20px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form__field { display: flex; flex-direction: column; gap: 6px; }
  .form__label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
  .form__input { padding: 11px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: 15px; font-family: var(--font-body); color: var(--ink); background: white; outline: none; transition: border-color 0.15s; }
  .form__input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(45,74,43,0.08); }
  .form__select { appearance: none; cursor: pointer; }
  .form__textarea { resize: vertical; min-height: 90px; }
  .form__submit { align-self: flex-start; padding: 14px 32px; font-size: 15px; }

  .form-message { padding: 20px 24px; border-radius: 10px; margin-top: 8px; font-size: 21px; line-height: 1.5; }
  .form-message--success { background: #edf7ed; color: #1a4a1a; border: 1px solid #b8d8b8; }
  .form-message--error { background: #fef2f2; color: #7a1a1a; border: 1px solid #f0b8b8; }

  @media (max-width: 768px) {
    .times-grid, .form__row { grid-template-columns: 1fr; }
    .location-card { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  import { awaitTurnstileToken } from '../lib/turnstile';
  import { showFormError } from '../lib/forms';

  document.getElementById('visitor-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Sending...';
    btn.disabled = true;
    // Turnstile injects its hidden input into the form, so FormData picks
    // the token up on its own — but only once it's there.
    const token = await awaitTurnstileToken(form);
    if (!token && form.querySelector('.cf-turnstile')) {
      showFormError(form, btn, 'Still checking your browser — please wait a moment and submit again.', 'Send →');
      return;
    }

    const data = Object.fromEntries(new FormData(form));
    try {
      const res = await fetch(`${form.dataset.apiBase}/api/forms/im-new`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.style.display = 'none';
        document.getElementById('form-success')!.style.display = 'block';
        return;
      }
      throw new Error(res.status === 403 ? 'verification' : 'server');
    } catch (e) {
      showFormError(
        form,
        btn,
        (e as Error).message === 'verification' ? 'We could not verify that you are human. Please reload the page and try again.' : '',
        'Send →',
      );
    }
  });
</script>

