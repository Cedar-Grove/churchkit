---
import Layout from '../layouts/Layout.astro';
import HoneypotField from '../components/HoneypotField.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import { env } from 'cloudflare:workers';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Prayer Request" description="Share a prayer request with us — we'd love to pray for you.">
  <Nav />

  <section class="page-header">
    <div class="container">
      <p class="page-header__eyebrow">Prayer</p>
      <h1 class="page-header__title">Share a Prayer Request</h1>
      <p class="page-header__body">We'd love to pray for you. Fill out the form below and our team will lift up your request.</p>
    </div>
  </section>

  <section class="section form-section">
    <div class="container--narrow">
      <form id="prayer-form" class="form" data-api-base={env.API_BASE}>
        <HoneypotField />
        <TurnstileWidget />
        <div class="form__row">
          <div class="form__field">
            <label class="form__label" for="firstName">First Name *</label>
            <input class="form__input" type="text" id="firstName" name="firstName" required />
          </div>
          <div class="form__field">
            <label class="form__label" for="lastName">Last Name</label>
            <input class="form__input" type="text" id="lastName" name="lastName" />
          </div>
        </div>
        <div class="form__row">
          <div class="form__field">
            <label class="form__label" for="email">Email Address</label>
            <input class="form__input" type="email" id="email" name="email" />
          </div>
          <div class="form__field">
            <label class="form__label" for="phone">Phone Number</label>
            <input class="form__input" type="tel" id="phone" name="phone" />
          </div>
        </div>
        <p class="form__hint">Optional, unless you'd like a reply.</p>
        <div class="form__field">
          <label class="form__label" for="request">Prayer Request *</label>
          <textarea class="form__input form__textarea" id="request" name="request" rows="5" required placeholder="Share what's on your heart…"></textarea>
        </div>
        <div class="form__field form__field--checkboxes">
          <label class="form__checkbox">
            <input type="checkbox" name="reply_requested" />
            <span>I would like someone to follow up with me</span>
          </label>
          <label class="form__checkbox">
            <input type="checkbox" name="prayer_list" />
            <span>Add this to the church prayer list</span>
          </label>
        </div>
        <button type="submit" class="btn btn--primary form__submit">Submit Prayer Request →</button>
      </form>

      <div id="form-success" class="form-message form-message--success" style="display:none">
        <strong>Thank you!</strong> Your prayer request has been received.
      </div>
      <div id="form-error" class="form-message form-message--error" style="display:none">
        Something went wrong. Please try again, or contact us if it keeps happening.
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header { background: var(--brand); padding: 130px 0 108px; }
  .page-header__eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent); margin-bottom: 12px; }
  .page-header__title { font-size: clamp(50px, 7vw, 73px); font-weight: 600; color: white; line-height: 1.1; margin-bottom: 16px; }
  .page-header__body { font-family: var(--font-heading); font-size: 22px; color: rgba(255,255,255,0.75); font-weight: 300; font-style: italic; max-width: 580px; line-height: 1.75; }

  .form-section { background: white; }
  .form { display: flex; flex-direction: column; gap: 20px; margin-top: 12px; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form__field { display: flex; flex-direction: column; gap: 6px; }
  .form__label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
  .form__hint { font-family: var(--font-heading); font-size: 13px; color: var(--ink-faint); margin: -10px 0 0; font-style: italic; }
  .form__input { padding: 11px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: 15px; font-family: var(--font-body); color: var(--ink); background: white; outline: none; transition: border-color 0.15s; }
  .form__input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(45,74,43,0.08); }
  .form__textarea { resize: vertical; min-height: 120px; }
  .form__field--checkboxes { gap: 12px; }
  .form__checkbox { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--ink-soft); cursor: pointer; }
  .form__checkbox input { width: 17px; height: 17px; accent-color: var(--brand); cursor: pointer; }
  .form__submit { align-self: flex-start; padding: 14px 32px; font-size: 15px; }

  .form-message { padding: 20px 24px; border-radius: 10px; margin-top: 8px; font-size: 21px; line-height: 1.5; }
  .form-message--success { background: #edf7ed; color: #1a4a1a; border: 1px solid #b8d8b8; }
  .form-message--error { background: #fef2f2; color: #7a1a1a; border: 1px solid #f0b8b8; }

  @media (max-width: 768px) {
    .form__row { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { awaitTurnstileToken, TURNSTILE_FIELD } from '../lib/turnstile';
  import { showFormError } from '../lib/forms';

  document.getElementById('prayer-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    const fd = new FormData(form);
    const data: Record<string, any> = {
      firstName: (fd.get('firstName') as string || '').trim(),
      lastName: (fd.get('lastName') as string || '').trim(),
      email: (fd.get('email') as string || '').trim(),
      phone: (fd.get('phone') as string || '').trim(),
      request: (fd.get('request') as string || '').trim(),
      reply_requested: fd.get('reply_requested') === 'on',
      prayer_list: fd.get('prayer_list') === 'on',
      // This form assembles its payload field by field rather than handing
      // over the whole FormData, so the decoy field has to be copied across
      // by name — without this the API's honeypot check never sees it and
      // this one form is the only one a blind spam script gets past.
      website: fd.get('website') || '',
    };

    if (!data.firstName || !data.request) {
      document.getElementById('form-error')!.textContent = 'Please enter your first name and your prayer request.';
      document.getElementById('form-error')!.style.display = 'block';
      return;
    }
    if (data.reply_requested && !data.email && !data.phone) {
      document.getElementById('form-error')!.textContent = "Please provide an email or phone number so we can follow up with you.";
      document.getElementById('form-error')!.style.display = 'block';
      return;
    }

    document.getElementById('form-error')!.style.display = 'none';
    btn.textContent = 'Submitting...';
    btn.disabled = true;

    const token = await awaitTurnstileToken(form);
    if (!token && form.querySelector('.cf-turnstile')) {
      showFormError(form, btn, 'Still checking your browser — please wait a moment and submit again.', 'Submit Prayer Request →');
      return;
    }
    if (token) data[TURNSTILE_FIELD] = token;

    try {
      const res = await fetch(`${form.dataset.apiBase}/api/forms/prayer-request`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.style.display = 'none';
        document.getElementById('form-success')!.style.display = 'block';
        return;
      }
      throw new Error(res.status === 403 ? 'verification' : 'server');
    } catch (e) {
      showFormError(
        form,
        btn,
        (e as Error).message === 'verification'
          ? 'We could not verify that you are human. Please reload the page and try again.'
          : 'Something went wrong. Please try again, or contact us if it keeps happening.',
        'Submit Prayer Request →',
      );
    }
  });
</script>
