---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FeaturedEventSection from '../components/home/FeaturedEventSection.astro';
import LatestSermonSection from '../components/home/LatestSermonSection.astro';
import PillarsSection from '../components/home/PillarsSection.astro';
import EventsPreviewSection from '../components/home/EventsPreviewSection.astro';
import InfoStripSection from '../components/home/InfoStripSection.astro';
import { getHome, getEvents, getCarousel } from '../lib/api';
import { env } from '../lib/env';
import { formatsFrom } from '../lib/format';
import { resolveHomeLayout } from '@churchkit/config/home-layouts';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');

const apiBase = env.API_BASE;
const [home, events, carouselResult] = await Promise.allSettled([
  getHome(apiBase),
  getEvents(apiBase),
  getCarousel(apiBase),
]);

const { settings, latestSermonWithVideo, featuredEvent, liveStream } =
  home.status === 'fulfilled' ? home.value : { settings: {}, latestSermonWithVideo: null, featuredEvent: null, liveStream: null };

const upcomingEvents =
  events.status === 'fulfilled' ? events.value.slice(0, 3) : [];

const carouselSlides: any[] =
  carouselResult.status === 'fulfilled' ? carouselResult.value : [];

// No invented service times. A wrong time published in a church's own
// voice sends visitors to a locked building; an empty section just says
// nothing until staff fill it in.
const serviceTimes: Record<string, string[]> = settings.service_times ?? {};

/**
 * Days this church meets, in the order it listed them. Any day key works —
 * a church meeting on Saturday, or twice on Sunday under two labels, says
 * so in its settings without anyone editing this page.
 */
const serviceDays: [string, string[]][] = Object.entries(serviceTimes)
  .filter(([, times]) => Array.isArray(times) && times.length > 0)
  .map(([day, times]) => [day.charAt(0).toUpperCase() + day.slice(1), times as string[]]);

// Times are rendered in the church's own timezone and locale, not the
// server's. See lib/format.ts.
const formats = formatsFrom(settings);

/**
 * Every piece of homepage copy that isn't already church-specific data
 * (name, tagline, service times, ...) — headings, button labels, the
 * Vision/pillars prose. All of it is editable from admin's Homepage tab;
 * these are just the defaults a fresh deployment renders until a church
 * writes its own.
 */
const text = {
  liveBanner: settings.home_live_banner_text || "We're live right now — click here to watch the live stream",
  heroCtaPrimary: settings.home_hero_cta_primary || 'Plan Your Visit',
  heroCtaSecondary: settings.home_hero_cta_secondary || 'Learn More',
  featuredEventEyebrow: settings.home_featured_event_eyebrow || 'Featured Event',
  featuredEventFallbackName: settings.home_featured_event_fallback_name || 'Upcoming Event',
  featuredEventCta: settings.home_featured_event_cta || 'Register Now →',
  sermonEyebrow: settings.home_sermon_eyebrow || 'Latest Message',
  sermonFallbackTitle: settings.home_sermon_fallback_title || 'Sunday Service',
  sermonCtaWatch: settings.home_sermon_cta_watch || 'Watch Now',
  sermonCtaBrowse: settings.home_sermon_cta_browse || 'Browse All Messages',
  visionEyebrow: settings.home_vision_eyebrow || 'Our Vision',
  visionHeading: settings.home_vision_heading || 'Believe · Belong · Become',
  pillar1Title: settings.home_pillar1_title || 'Believe in God',
  pillar1Body: settings.home_pillar1_body || 'Our walk of faith starts with knowing God through Jesus, spending time in His Word, in prayer, and in worship.',
  pillar2Title: settings.home_pillar2_title || 'Belong to Community',
  pillar2Body: settings.home_pillar2_body || "The Christian life isn't meant to be lived alone. We gather together so we can grow together in genuine community.",
  pillar3Title: settings.home_pillar3_title || 'Become like Jesus',
  pillar3Body: settings.home_pillar3_body || 'We become like Jesus when we love and serve who Jesus loves: the Church, our communities, and the world.',
  eventsEyebrow: settings.home_events_eyebrow || "What's Coming Up",
  eventsHeading: settings.home_events_heading || 'Upcoming Events',
  eventsCta: settings.home_events_cta || 'See All Events',
  eventRegisterLabel: settings.home_event_register_label || 'Register →',
  eventFreeLabel: settings.home_event_free_label || 'Free',
  gatheringHeading: settings.home_gathering_heading || 'Gathering Times',
  gatheringCta: settings.home_gathering_cta || 'Plan My Visit',
  findUsHeading: settings.home_findus_heading || 'Find Us',
  findUsCta: settings.home_findus_cta || 'Get Directions',
  connectHeading: settings.home_connect_heading || 'Connect With Us',
  connectBody: settings.home_connect_body || "New here? We'd love to meet you. Fill out a connect card and our team will reach out.",
  connectCta1: settings.home_connect_cta1 || 'Fill Out a Connect Card',
  connectCta2: settings.home_connect_cta2 || "I'm New Here",
  connectCta3: settings.home_connect_cta3 || 'Share a Prayer Request',
};

/**
 * The hero and footer frame every layout and are never reordered; what a
 * layout actually changes is which of these five content blocks comes
 * right after the hero. Each component decides for itself whether it has
 * anything to show (see e.g. FeaturedEventSection), so moving one to a
 * different position never invents content that was not there before.
 */
const SECTION_COMPONENTS: Record<string, any> = {
  'featured-event': FeaturedEventSection,
  'latest-sermon': LatestSermonSection,
  pillars: PillarsSection,
  'events-preview': EventsPreviewSection,
  'info-strip': InfoStripSection,
};
const homeLayout = resolveHomeLayout(settings.home_layout);
---

<Layout>
  {liveStream?.isLive && (
    <a href={liveStream.url} target="_blank" rel="noopener" class="live-banner">
      <svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="currentColor"/></svg>
      {text.liveBanner}
    </a>
  )}
  <Nav />

  <section class="hero" id="hero">
    <div class="hero__left">
      {carouselSlides.length > 0 ? (
        <>
          <div class="hero__slides">
            {carouselSlides.map((slide: any, i: number) => (
              <div class={`hero__slide${i === 0 ? ' hero__slide--active' : ''}`} data-slide={i}>
                {slide.image_url
                  ? <div class="hero__bg" style={`background-image: url('${slide.image_url}'); background-size: cover; background-position: center;`}></div>
                  : <div class="hero__bg hero__bg--1"></div>
                }
                <div class="hero__overlay"></div>
                {!slide.image_url && (
                  <div class="container hero__content">
                    {slide.headline && <h1 class="hero__title">{slide.headline}</h1>}
                    {slide.subtext && <p class="hero__body">{slide.subtext}</p>}
                    {slide.button_label && slide.button_link && (
                      <div class="hero__actions">
                        <a href={slide.button_link} class="btn btn--accent">{slide.button_label}</a>
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
          <div class="hero__dots">
            {carouselSlides.map((_: any, i: number) => (
              <button class={`hero__dot${i === 0 ? ' hero__dot--active' : ''}`} data-target={i} aria-label={`Slide ${i + 1}`}></button>
            ))}
          </div>
          <button class="hero__arrow hero__arrow--prev" id="hero-prev" aria-label="Previous slide">&#8249;</button>
          <button class="hero__arrow hero__arrow--next" id="hero-next" aria-label="Next slide">&#8250;</button>
        </>
      ) : (
        <div class="hero__slide hero__slide--active">
          <div class="hero__bg hero__bg--1"></div>
          <div class="hero__overlay"></div>
          <div class="container hero__content">
            {/*
              With no carousel slides configured this falls back to the
              church's own name and tagline — never to invented copy about
              service times or what a visit is like.
            */}
            <h1 class="hero__title">{settings.church_name ?? ''}</h1>
            {settings.tagline && <p class="hero__body">{settings.tagline}</p>}
            <div class="hero__actions">
              <a href="/im-new" class="btn btn--accent">{text.heroCtaPrimary}</a>
              <a href="/about" class="btn btn--outline-white">{text.heroCtaSecondary}</a>
            </div>
          </div>
        </div>
      )}
    </div>
    {settings.hero_image_url && (
      <div class="hero__right">
        <img src={settings.hero_image_url} alt={settings.church_name ?? ''} class="hero__photo" />
      </div>
    )}
  </section>

  {homeLayout.sections.map((id: string) => {
    const Section = SECTION_COMPONENTS[id];
    if (!Section) return null;
    return (
      <Section
        featuredEvent={featuredEvent}
        latestSermonWithVideo={latestSermonWithVideo}
        upcomingEvents={upcomingEvents}
        settings={settings}
        serviceDays={serviceDays}
        text={text}
        formats={formats}
      />
    );
  })}

  <Footer />
</Layout>

<style>
  .hero { display: flex; height: 580px; overflow: hidden; background: var(--brand); }
  .hero__left { position: relative; width: 50%; flex-shrink: 0; }
  .hero__right { width: 50%; flex-shrink: 0; overflow: hidden; }
  .hero__photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__slides { position: relative; width: 100%; height: 100%; }
  .hero__slide { position: absolute; inset: 0; display: flex; align-items: center; opacity: 0; transition: opacity 0.8s ease; pointer-events: none; }
  .hero__slide--active { opacity: 1; pointer-events: auto; }
  .hero__bg { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .hero__bg--1 { background: var(--brand); }
  .hero__overlay { position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 50%, rgba(255,255,255,0.04), transparent 60%); }
  .hero__content { position: relative; z-index: 2; max-width: 600px; }
  .hero__title { font-size: clamp(56px, 8.4vw, 90px); color: white; font-weight: 600; line-height: 1.08; letter-spacing: -1px; margin-bottom: 18px; }
  .hero__body { font-family: var(--font-heading); font-size: 24px; color: rgba(255,255,255,0.78); line-height: 1.6; font-weight: 300; margin-bottom: 32px; max-width: 480px; }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn--outline-white { border: 2px solid rgba(255,255,255,0.5); color: white; background: transparent; }
  .btn--outline-white:hover { border-color: white; background: rgba(255,255,255,0.08); }
  .hero__dots { position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); display: flex; gap: 8px; z-index: 10; }
  .hero__dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.35); border: none; cursor: pointer; transition: all 0.2s; padding: 0; }
  .hero__dot--active { background: var(--accent); width: 24px; border-radius: 4px; }
  .hero__arrow { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); color: white; width: 44px; height: 44px; border-radius: 50%; font-size: 22px; cursor: pointer; z-index: 10; display: flex; align-items: center; justify-content: center; transition: all 0.2s; line-height: 1; }
  .hero__arrow:hover { background: rgba(255,255,255,0.22); }
  .hero__arrow--prev { left: 24px; }
  .hero__arrow--next { right: 24px; }
  .live-banner {
    display: block;
    background: #c0392b;
    color: white;
    text-align: center;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    text-decoration: none;
  }
  .live-banner:hover { background: #a8321f; }
  @media (max-width: 768px) {
    .hero { height: auto; flex-direction: column; }
    .hero__left { width: 100%; height: 420px; }
    .hero__right { width: 100%; height: 260px; }
    .hero__arrow { display: none; }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.hero__slide');
  const dots = document.querySelectorAll<HTMLElement>('.hero__dot');
  if (slides.length > 1) {
    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    function goTo(index: number) {
      slides[current].classList.remove('hero__slide--active');
      dots[current].classList.remove('hero__dot--active');
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('hero__slide--active');
      dots[current].classList.add('hero__dot--active');
    }
    function startTimer() { timer = setInterval(() => goTo(current + 1), 5000); }
    function resetTimer() { clearInterval(timer); startTimer(); }
    dots.forEach(dot => {
      dot.addEventListener('click', () => { goTo(parseInt(dot.dataset.target || '0')); resetTimer(); });
    });
    document.getElementById('hero-prev')?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
    document.getElementById('hero-next')?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
    let touchStartX = 0;
    const hero = document.getElementById('hero');
    hero?.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
    hero?.addEventListener('touchend', e => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) { goTo(diff > 0 ? current + 1 : current - 1); resetTimer(); }
    });
    startTimer();
  }
</script>
