---
import Layout from '../layouts/Layout.astro';
import HoneypotField from '../components/HoneypotField.astro';
import TurnstileWidget from '../components/TurnstileWidget.astro';
import { env } from '../lib/env';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Connect Card" description="Fill out our connect card to get plugged in.">
  <Nav />

  <section class="page-header">
    <div class="container">
      <p class="page-header__eyebrow">Get Connected</p>
      <h1 class="page-header__title">Connect Card</h1>
      <p class="page-header__body">We'd love to get to know you. Fill out the form below and we'll reach out soon.</p>
    </div>
  </section>

  <section class="section">
    <div class="container--narrow">
      <form id="connect-card-form" class="form" data-api-base={env.API_BASE}>
        <HoneypotField />
        <TurnstileWidget />

        <div class="form__section">
          <h3 class="form__section-title">Personal Information</h3>
          <div class="form__row">
            <div class="form__field">
              <label class="form__label" for="firstName">First Name *</label>
              <input class="form__input" type="text" id="firstName" name="firstName" required />
            </div>
            <div class="form__field">
              <label class="form__label" for="lastName">Last Name *</label>
              <input class="form__input" type="text" id="lastName" name="lastName" required />
            </div>
          </div>
          <div class="form__row">
            <div class="form__field">
              <label class="form__label" for="email">Email Address *</label>
              <input class="form__input" type="email" id="email" name="email" required />
            </div>
            <div class="form__field">
              <label class="form__label" for="phone">Phone Number</label>
              <input class="form__input" type="tel" id="phone" name="phone" />
            </div>
          </div>
          <div class="form__row">
            <div class="form__field">
              <label class="form__label" for="birthdate">Birthdate</label>
              <input class="form__input" type="date" id="birthdate" name="birthdate" />
            </div>
            <div class="form__field">
              <label class="form__label" for="spouseName">Spouse's Name</label>
              <input class="form__input" type="text" id="spouseName" name="spouse_name" />
            </div>
          </div>
        </div>

        <div class="form__section">
          <h3 class="form__section-title">Home Address</h3>
          <div class="form__field">
            <label class="form__label" for="street">Street Address</label>
            <input class="form__input" type="text" id="street" name="street" />
          </div>
          <div class="form__row form__row--addr">
            <div class="form__field form__field--city">
              <label class="form__label" for="city">City</label>
              <input class="form__input" type="text" id="city" name="city" />
            </div>
            <div class="form__field form__field--state">
              <label class="form__label" for="state">State</label>
              <input class="form__input" type="text" id="state" name="state" maxlength="2" placeholder="AL" />
            </div>
            <div class="form__field form__field--zip">
              <label class="form__label" for="zip">ZIP</label>
              <input class="form__input" type="text" id="zip" name="zip" maxlength="10" />
            </div>
          </div>
        </div>

        <div class="form__section">
          <h3 class="form__section-title">Children at Home</h3>
          <p class="form__section-note">Add any children living with you — name and grade or age.</p>
          <div id="children-list"></div>
          <button type="button" id="add-child" class="btn btn--outline" style="margin-top: 12px; font-size: 13px; padding: 9px 18px;">+ Add Child</button>
        </div>

        <div class="form__section">
          <h3 class="form__section-title">Spiritual Journey</h3>
          <p class="form__section-note">Check all that apply.</p>
          <div class="checkbox-group">
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I am a Christian" />
              <span>I am a Christian</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I have been baptized" />
              <span>I have been baptized</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I am a member" />
              <span>I am a member</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I would like to become a member" />
              <span>I would like to become a member</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I recently gave my life to Christ" />
              <span>I recently gave my life to Christ</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I made a rededication of faith" />
              <span>I made a rededication of faith</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I would like to be baptized" />
              <span>I would like to be baptized</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="spiritual_journey" value="I am exploring Christianity" />
              <span>I am exploring Christianity</span>
            </label>
          </div>
        </div>

        <div class="form__section">
          <h3 class="form__section-title">How You Found Us</h3>
          <div class="form__field">
            <label class="form__label" for="howHeard">How did you hear about us?</label>
            <select class="form__input form__select" id="howHeard" name="how_found">
              <option value="">— Select —</option>
              <option value="Friend or family member">Friend or Family Member</option>
              <option value="Drove by the church">Drove By the Church</option>
              <option value="Facebook / Instagram">Facebook / Instagram</option>
              <option value="Google search">Google Search</option>
              <option value="Community event">Community Event</option>
              <option value="Already a member">Already a Member</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div class="form__section">
          <h3 class="form__section-title">Notes &amp; Prayer Requests</h3>
          <div class="form__field">
            <label class="form__label" for="notes">General Notes or Questions</label>
            <textarea class="form__input form__textarea" id="notes" name="notes" rows="3"></textarea>
          </div>
          <div class="form__field" style="margin-top: 20px;">
            <label class="form__label" for="prayerRequest">Prayer Request</label>
            <textarea class="form__input form__textarea" id="prayerRequest" name="prayer_request" rows="3"></textarea>
          </div>
          <div class="form__field" style="margin-top: 20px;">
            <label class="form__label">Prayer Request Privacy</label>
            <div class="radio-group">
              <label class="radio-item">
                <input type="radio" name="prayer_privacy" value="congregation" checked />
                <span>Share with the congregation</span>
              </label>
              <label class="radio-item">
                <input type="radio" name="prayer_privacy" value="pastoral" />
                <span>Share with the pastoral team only</span>
              </label>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn--primary form__submit">Submit Connect Card →</button>
      </form>

      <div id="form-success" class="form-message form-message--success" style="display:none">
        <strong>Thank you for connecting with us!</strong> Our team will reach out soon. We're grateful you're here.
      </div>
      <div id="form-error" class="form-message form-message--error" style="display:none">
        Something went wrong. Please try again, or contact us if it keeps happening.
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header { background: var(--brand); padding: 130px 0 108px; }
  .page-header__eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 2.5px; color: var(--accent); margin-bottom: 12px; }
  .page-header__title { font-size: clamp(50px, 7vw, 73px); font-weight: 600; color: white; line-height: 1.1; margin-bottom: 12px; }
  .page-header__body { font-family: var(--font-heading); font-size: 24px; color: rgba(255,255,255,0.7); font-weight: 300; }

  .form { display: flex; flex-direction: column; }
  .form__section { padding: 36px 0; border-bottom: 1px solid var(--border-soft); }
  .form__section:last-of-type { border-bottom: none; }
  .form__section-title { font-size: 28px; color: var(--brand); font-weight: 600; margin-bottom: 6px; }
  .form__section-note { font-size: 13px; color: var(--ink-faint); margin-bottom: 18px; }

  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
  .form__row--addr { grid-template-columns: 2fr 1fr 1fr; }
  .form__row:last-child { margin-bottom: 0; }
  .form__field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
  .form__field:last-child { margin-bottom: 0; }
  .form__label { font-size: 13px; font-weight: 600; color: var(--ink-soft); }
  .form__input { padding: 11px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: 15px; font-family: var(--font-body); color: var(--ink); background: white; outline: none; transition: border-color 0.15s; }
  .form__input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(45,74,43,0.08); }
  .form__select { appearance: none; cursor: pointer; }
  .form__textarea { resize: vertical; min-height: 80px; }
  .form__submit { align-self: flex-start; padding: 14px 32px; font-size: 15px; margin-top: 32px; }

  .child-row { display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; align-items: end; margin-bottom: 12px; }
  .child-row__remove { background: none; border: 1px solid var(--border); border-radius: 8px; color: var(--ink-faint); padding: 11px 14px; cursor: pointer; font-size: 16px; transition: all 0.15s; line-height: 1; font-family: var(--font-body); }
  .child-row__remove:hover { border-color: #e57373; color: #e57373; }

  .checkbox-group { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .checkbox-item, .radio-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; transition: all 0.15s; font-size: 14px; color: var(--ink-soft); }
  .checkbox-item:hover, .radio-item:hover { border-color: var(--brand-light); background: var(--brand-faint); }
  .checkbox-item input, .radio-item input { accent-color: var(--brand); flex-shrink: 0; }
  .radio-group { display: flex; flex-direction: column; gap: 10px; }

  .form-message { padding: 20px 24px; border-radius: 10px; margin-top: 16px; font-size: 21px; line-height: 1.5; }
  .form-message--success { background: #edf7ed; color: #1a4a1a; border: 1px solid #b8d8b8; }
  .form-message--error { background: #fef2f2; color: #7a1a1a; border: 1px solid #f0b8b8; }

  @media (max-width: 768px) {
    .form__row, .form__row--addr, .checkbox-group { grid-template-columns: 1fr; }
    .child-row { grid-template-columns: 1fr auto; }
  }
</style>

<script>
  import { awaitTurnstileToken } from '../lib/turnstile';
  import { showFormError } from '../lib/forms';

  let childCount = 0;
  const childrenList = document.getElementById('children-list')!;

  document.getElementById('add-child')?.addEventListener('click', () => {
    const idx = childCount++;
    const row = document.createElement('div');
    row.className = 'child-row';
    row.innerHTML = `
      <div class="form__field" style="margin-bottom:0">
        <label class="form__label">Child's Name</label>
        <input class="form__input" type="text" name="children[${idx}][name]" placeholder="First name" />
      </div>
      <div class="form__field" style="margin-bottom:0">
        <label class="form__label">Grade / Age</label>
        <input class="form__input" type="text" name="children[${idx}][grade]" placeholder="e.g. 3rd grade" />
      </div>
      <button type="button" class="child-row__remove" aria-label="Remove child"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
    `;
    row.querySelector('.child-row__remove')?.addEventListener('click', () => row.remove());
    childrenList.appendChild(row);
  });

  document.getElementById('connect-card-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = 'Submitting...';
    btn.disabled = true;

    // Turnstile's hidden input is part of the form, so the fd.forEach below
    // carries the token through with the rest of the fields.
    const token = await awaitTurnstileToken(form);
    if (!token && form.querySelector('.cf-turnstile')) {
      showFormError(form, btn, 'Still checking your browser — please wait a moment and submit again.', 'Submit Connect Card →');
      return;
    }

    const fd = new FormData(form);
    const data: Record<string, any> = {};
    const spiritualJourney: string[] = [];
    const children: Record<string, Record<string, string>> = {};

    fd.forEach((value, key) => {
      if (key === 'spiritual_journey') {
        spiritualJourney.push(value as string);
      } else if (key.startsWith('children[')) {
        const match = key.match(/children\[(\d+)\]\[(\w+)\]/);
        if (match) {
          const [, idx, field] = match;
          if (!children[idx]) children[idx] = {};
          children[idx][field] = value as string;
        }
      } else if (['street', 'city', 'state', 'zip'].includes(key)) {
        // nested under `address`, matching the app's payload shape
      } else {
        data[key] = value;
      }
    });

    data.address = {
      street: fd.get('street') as string,
      city: fd.get('city') as string,
      state: fd.get('state') as string,
      zip: fd.get('zip') as string,
    };
    data.spiritual_journey = spiritualJourney;
    data.children = Object.values(children).filter(c => c.name);

    try {
      const res = await fetch(`${form.dataset.apiBase}/api/forms/connect-card`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.style.display = 'none';
        document.getElementById('form-success')!.style.display = 'block';
        return;
      }
      throw new Error(res.status === 403 ? 'verification' : 'server');
    } catch (e) {
      showFormError(
        form,
        btn,
        (e as Error).message === 'verification' ? 'We could not verify that you are human. Please reload the page and try again.' : '',
        'Submit Connect Card →',
      );
    }
  });
</script>

