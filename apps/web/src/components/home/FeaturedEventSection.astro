---
import { formatDate } from '../../lib/format';

interface Props {
  featuredEvent: any;
  text: Record<string, string>;
  formats: any;
  theme: string;
}
const { featuredEvent, text, formats, theme } = Astro.props;

function shortDate(dateStr: string) {
  return formatDate(new Date(dateStr), formats, { month: 'short', day: 'numeric', year: 'numeric' });
}
---

{featuredEvent && (
  <div class={`featured-strip featured-strip--${theme}`} data-theme={theme}>
    <div class="container featured-strip__inner">
      <div class="featured-strip__left">
        <div class="featured-strip__label"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.2l2.55 5.4 5.7.82-4.13 4.15.98 5.93L12 16.7l-5.1 2.8.97-5.93L3.75 9.42l5.7-.82L12 3.2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> {text.featuredEventEyebrow}</div>
        <div class="featured-strip__title">{featuredEvent.name || text.featuredEventFallbackName}</div>
        {featuredEvent.starts_at && (
          <div class="featured-strip__meta"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.4h16v15H4zM4 10h16M8.6 2.8v4.6M15.4 2.8v4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> {shortDate(featuredEvent.starts_at)}</div>
        )}
      </div>
      {featuredEvent.source === 'registrations' && (
        <a href={featuredEvent.registration_url} class="featured-strip__btn">{text.featuredEventCta}</a>
      )}
    </div>
  </div>
)}

<style>
  /* ── classic: solid accent band, white pill button ── */
  .featured-strip { background: var(--accent); padding: 36px 0; }
  .featured-strip__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .featured-strip__label { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ink-faint); margin-bottom: 6px; }
  .featured-strip__title { font-family: var(--font-heading); font-size: 36px; color: var(--ink); font-weight: 600; }
  .featured-strip__meta { display: inline-flex; align-items: center; gap: 8px; font-size: 21px; color: var(--ink-soft); margin-top: 6px; }
  .featured-strip__btn { background: white; color: var(--brand); font-weight: 700; white-space: nowrap; display: inline-flex; align-items: center; padding: 12px 24px; border-radius: 30px; text-decoration: none; font-size: 14px; letter-spacing: 0.5px; transition: background 0.15s; }
  .featured-strip__btn:hover { background: var(--brand-faint); }

  /* ── editorial: flat, white bg, rule dividers, text-link action ── */
  .featured-strip--editorial { background: var(--white); padding: 44px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .featured-strip--editorial .featured-strip__label { color: var(--brand-mid); }
  .featured-strip--editorial .featured-strip__title { font-weight: 400; font-size: 32px; }
  .featured-strip--editorial .featured-strip__btn { background: none; color: var(--brand); border-radius: 0; border-bottom: 2px solid var(--accent); padding: 4px 0; }
  .featured-strip--editorial .featured-strip__btn:hover { background: none; color: var(--brand-mid); }

  /* ── bold: solid brand band, inverted white text, sharp button ── */
  .featured-strip--bold { background: var(--brand); padding: 44px 0; }
  .featured-strip--bold .featured-strip__label { color: rgba(255,255,255,0.65); }
  .featured-strip--bold .featured-strip__title { color: white; text-transform: uppercase; letter-spacing: 0.5px; }
  .featured-strip--bold .featured-strip__meta { color: rgba(255,255,255,0.8); }
  .featured-strip--bold .featured-strip__btn { background: var(--accent); color: var(--ink); border-radius: 2px; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; }

  /* ── minimal: no color block, hairline border, quiet ── */
  .featured-strip--minimal { background: var(--surface); padding: 28px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .featured-strip--minimal .featured-strip__title { font-size: 24px; font-weight: 500; }
  .featured-strip--minimal .featured-strip__btn { background: none; color: var(--brand); border: 1px solid var(--border); border-radius: 20px; padding: 8px 18px; font-size: 13px; }
  .featured-strip--minimal .featured-strip__btn:hover { border-color: var(--brand-light); background: none; }

  /* ── visitor-first: elevated card feel, prominent button ── */
  .featured-strip--visitor-first { background: var(--accent); padding: 28px 0; }
  .featured-strip--visitor-first .featured-strip__title { font-size: 28px; }
  .featured-strip--visitor-first .featured-strip__btn { padding: 14px 28px; font-size: 15px; }
</style>
