---
import { formatDate, formatTime } from '../../lib/format';

interface Props {
  upcomingEvents: any[];
  text: Record<string, string>;
  formats: any;
}
const { upcomingEvents, text, formats } = Astro.props;

function stripHtml(html: string): string {
  return html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
}

function formatEventDate(dateStr: string) {
  const d = new Date(dateStr);
  return {
    month: formatDate(d, formats, { month: 'short' }).toUpperCase(),
    day: formatDate(d, formats, { day: 'numeric' }),
    time: formatTime(d, formats),
    weekday: formatDate(d, formats, { weekday: 'long' }),
  };
}
---

{upcomingEvents.length > 0 && (
  <section class="section events-preview">
    <div class="container">
      <div class="events-preview__header">
        <div>
          <p class="section__eyebrow">{text.eventsEyebrow}</p>
          <h2 class="section__heading">{text.eventsHeading}</h2>
        </div>
        <a href="/events" class="btn btn--outline">{text.eventsCta}</a>
      </div>
      <div class="events-preview__grid">
        {upcomingEvents.map((event: any) => {
          const d = formatEventDate(event.starts_at);
          return (
            <div class="event-card">
              <div class="event-card__date">
                <span class="event-card__month">{d.month}</span>
                <span class="event-card__day">{d.day}</span>
              </div>
              <div class="event-card__info">
                <h3 class="event-card__title">{event.name}</h3>
                <p class="event-card__when">{d.weekday} · {d.time}</p>
                {event.description && (() => {
                  const t = stripHtml(event.description);
                  return <p class="event-card__desc">{t.substring(0, 100)}{t.length > 100 ? '...' : ''}</p>;
                })()}
              </div>
              {event.source === 'registrations' ? (
                <a href={event.registration_url} class="event-card__btn">{text.eventRegisterLabel}</a>
              ) : (
                <span class="event-card__btn event-card__btn--muted">{text.eventFreeLabel}</span>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .events-preview { background: white; }
  .events-preview__header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 32px; }
  .events-preview__grid { display: flex; flex-direction: column; gap: 14px; }
  .event-card { display: flex; align-items: center; gap: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px 24px; transition: all 0.2s; }
  .event-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); border-color: var(--brand-light); }
  .event-card__date { width: 56px; height: 56px; background: var(--brand-pale); border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid rgba(45,74,43,0.1); }
  .event-card__month { font-size: 9px; font-weight: 700; color: var(--brand-mid); letter-spacing: 0.5px; }
  .event-card__day { font-family: var(--font-heading); font-size: 22px; color: var(--brand); font-weight: 600; line-height: 1; }
  .event-card__info { flex: 1; min-width: 0; }
  .event-card__title { font-family: var(--font-heading); font-size: 25px; color: var(--brand); font-weight: 600; margin-bottom: 4px; }
  .event-card__when { font-size: 13px; color: var(--ink-faint); margin-bottom: 4px; }
  .event-card__desc { font-size: 18px; color: var(--ink-soft); font-weight: 300; }
  .event-card__btn { background: var(--brand); color: white; padding: 9px 18px; border-radius: 20px; font-size: 13px; font-weight: 700; white-space: nowrap; flex-shrink: 0; text-decoration: none; transition: background 0.15s; }
  .event-card__btn:hover { background: var(--brand-mid); }
  .event-card__btn--muted { background: var(--brand-faint); color: var(--brand-mid); cursor: default; }
  @media (max-width: 900px) {
    .events-preview__header { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (max-width: 768px) {
    .event-card { flex-wrap: wrap; }
  }
</style>
