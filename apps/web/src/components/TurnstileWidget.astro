---
/**
 * Cloudflare Turnstile challenge for the public forms.
 *
 * Sits alongside HoneypotField as the second half of the bot defence: the
 * honeypot catches scripts that blindly fill every input, this catches a
 * real (or headless) browser driving the form. The API verifies the token
 * in cedar-grove-api's src/lib/turnstile.ts.
 *
 * `interaction-only` appearance means nothing is shown at all to the
 * overwhelming majority of visitors — the widget only becomes visible if
 * Cloudflare decides that particular visitor needs to interact. No puzzles,
 * no checkbox on a normal visit.
 *
 * The sitekey is public by design (it's in the page HTML), and comes from
 * the TURNSTILE_SITE_KEY Worker var in wrangler.jsonc. With the var unset
 * the widget renders nothing, no token is sent, and the API — which treats
 * an unset TURNSTILE_SECRET as "not configured" — accepts submissions
 * exactly as it did before. That's what makes the two repos deployable
 * independently, but it also means the site must be deployed with the
 * sitekey BEFORE the secret is set on the API, or browser submissions get
 * a 403 in between.
 */
import { env } from '../lib/env';

// Read around the generated Env type rather than through it. The var is
// declared in wrangler.jsonc, but worker-configuration.d.ts is generated by
// `wrangler types` and committed, so typing this against it would make the
// site fail to build for anyone whose checkout predates a regeneration —
// and would collide once they do regenerate, since the generator emits the
// sitekey as a string literal rather than an optional. The empty fallback is
// the same "not configured" path described above.
const siteKey = (env as Record<string, unknown>).TURNSTILE_SITE_KEY as string | undefined ?? '';
---

{siteKey && (
  <>
    <div
      class="cf-turnstile turnstile-widget"
      data-sitekey={siteKey}
      data-appearance="interaction-only"
      data-theme="light"
      data-retry="auto"
    ></div>
    <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
  </>
)}

<style>
  /* Only ever occupies space when Turnstile actually shows something. */
  .turnstile-widget:not(:empty) { margin: 4px 0; }
</style>
