{
  "name": "churchkit",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "churchkit",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "tools"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/admin": {
      "name": "@churchkit/admin",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "apps/api": {
      "name": "@churchkit/api",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "apps/mobile": {
      "name": "@churchkit/mobile",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "apps/web": {
      "name": "@churchkit/web",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "node_modules/@churchkit/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "node_modules/@churchkit/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@churchkit/brand": {
      "resolved": "packages/brand",
      "link": true
    },
    "node_modules/@churchkit/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@churchkit/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@churchkit/tools": {
      "resolved": "tools",
      "link": true
    },
    "node_modules/@churchkit/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/brand": {
      "name": "@churchkit/brand",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "bin": {
        "churchkit-brand": "src/generate.mjs"
      }
    },
    "packages/config": {
      "name": "@churchkit/config",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "tools": {
      "name": "@churchkit/tools",
      "version": "0.1.0",
      "license": "Apache-2.0"
    }
  }
}
